<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mycompany.gestion_hotel.ui.LoginController"
            fx:id="anchorPane"
            prefWidth="800.0" prefHeight="600.0"
            style="-fx-background-color: #2c3e50;">

    <children>
        <!-- ImageView responsive que cubre todo el fondo -->
        <ImageView fx:id="backgroundImage" 
                   fitWidth="800.0" fitHeight="600.0"
                   preserveRatio="false"
                   pickOnBounds="true"
                   opacity="0.9">
            <image>
                <Image url="@../../../imagenes/Login.png" 
                       backgroundLoading="true"
                       preserveRatio="false" />
            </image>
            <AnchorPane.leftAnchor>0.0</AnchorPane.leftAnchor>
            <AnchorPane.rightAnchor>0.0</AnchorPane.rightAnchor>
            <AnchorPane.topAnchor>0.0</AnchorPane.topAnchor>
            <AnchorPane.bottomAnchor>0.0</AnchorPane.bottomAnchor>
        </ImageView>
        
        <!-- Overlay oscuro para mejor contraste -->
        <Pane style="-fx-background-color: rgba(0,0,0,0.4);">
            <AnchorPane.leftAnchor>0.0</AnchorPane.leftAnchor>
            <AnchorPane.rightAnchor>0.0</AnchorPane.rightAnchor>
            <AnchorPane.topAnchor>0.0</AnchorPane.topAnchor>
            <AnchorPane.bottomAnchor>0.0</AnchorPane.bottomAnchor>
        </Pane>
        
        <!-- Panel central de login -->
        <VBox alignment="CENTER" spacing="20" 
              style="-fx-background-color: rgba(255,255,255,0.95); -fx-background-radius: 20; -fx-padding: 40; -fx-border-color: #bdc3c7; -fx-border-width: 1; -fx-border-radius: 20;"
              maxWidth="400">
            <AnchorPane.leftAnchor>100.0</AnchorPane.leftAnchor>
            <AnchorPane.rightAnchor>100.0</AnchorPane.rightAnchor>
            <AnchorPane.topAnchor>80.0</AnchorPane.topAnchor>
            <AnchorPane.bottomAnchor>80.0</AnchorPane.bottomAnchor>
            
            <!-- Logo/Título -->
            <VBox alignment="CENTER" spacing="10">
                <Label text="Hotel Terrazas" 
                       style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Pane style="-fx-background-color: #3498db; -fx-pref-height: 2; -fx-pref-width: 200;"/>
                <Label text="Sistema de Gestión" 
                       style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
            </VBox>
            
            <!-- Espaciador -->
            <Region prefHeight="20" />
            
            <!-- Campos de formulario -->
            <VBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 0 20;">
                <!-- Campo Correo -->
                <VBox spacing="5">
                    <Label text="Correo electrónico" 
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <TextField fx:id="txtCorreo" 
                               promptText="usuario@hotelterrazas.com"
                               style="-fx-background-radius: 10; -fx-padding: 12; -fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-radius: 10; -fx-font-size: 14px;"/>
                </VBox>
                
                <!-- Campo Contraseña -->
                <VBox spacing="5">
                    <Label text="Contraseña" 
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <PasswordField fx:id="txtContrasena" 
                                   promptText="Ingrese su contraseña"
                                   style="-fx-background-radius: 10; -fx-padding: 12; -fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-radius: 10; -fx-font-size: 14px;"/>
                </VBox>
            </VBox>
            
            <!-- Espaciador -->
            <Region prefHeight="10" />
            
            <!-- Botón de login -->
            <Button text="Iniciar sesión" fx:id="btnLogin"
                    style="-fx-background-color: linear-gradient(to right, #3498db, #2980b9); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 10; -fx-padding: 15 40;"
                    onAction="#handleLogin"/>
            
            <!-- Mensaje de estado -->
            <Label fx:id="lblMensaje" 
                   style="-fx-font-size: 12px; -fx-text-fill: #e74c3c; -fx-font-weight: bold; -fx-wrap-text: true; -fx-max-width: 300; -fx-alignment: center;"/>
            
            <!-- Footer -->
            <Label text="© 2024 Hotel Terrazas. Todos los derechos reservados." 
                   style="-fx-font-size: 10px; -fx-text-fill: #95a5a6; -fx-padding: 20 0 0 0;"/>
        </VBox>
    </children>
</AnchorPane>