<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mycompany.gestion_hotel.ui.InventarioController">

    <top>
    <VBox spacing="8">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <Label text="Inventario de Productos"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

        <Label fx:id="lblAlerta"
               textFill="red"
               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    </VBox>
</top>


    <center>
        <TableView fx:id="tablaProductos" prefHeight="400" prefWidth="900">
            <columns>

                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180"/>
                <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="120"/>
                <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="100"/>
                <TableColumn fx:id="colPrecio" text="Precio" prefWidth="100"/>
                <TableColumn fx:id="colUbicacion" text="Ubicación" prefWidth="120"/>
                <TableColumn fx:id="colProveedor" text="Proveedor" prefWidth="120"/>

            </columns>
        </TableView>
    </center>

    <bottom>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <padding>
            <Insets top="15" right="15" bottom="15" left="15"/>
        </padding>

        <Label text="Nueva cantidad:"/>
        <TextField fx:id="txtNuevaCantidad" promptText="Cantidad" prefWidth="120"/>

        <Button text="Actualizar Cantidad"
                fx:id="btnActualizarCantidad"
                style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-padding: 10 20;"/>
    </HBox>
</bottom>


</BorderPane>
